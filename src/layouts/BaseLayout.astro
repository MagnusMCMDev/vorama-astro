---
// Tokens y estilos base — globales para toda la página
import '~/styles/theme.css';
import '~/styles/globals.css';
// Fuentes self-hosted — para <link rel="preload">
import interFontUrl from '~/assets/fonts/inter-latin.woff2?url';
import brygadaFontUrl from '~/assets/fonts/brygada1918-latin.woff2?url';
// Componentes de layout presentes en todas las páginas
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import WhatsAppFloating from '~/components/layout/WhatsAppFloating.astro';
import BackToTop from '~/components/layout/BackToTop.astro';
// Diálogos interactivos — disponibles en todas las páginas
import BookingDialog from '~/components/booking/BookingDialog.astro';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import ogDefault from '~/assets/images/pages/captura-video.webp';

interface Props {
  /** <title> de la página. Debe ser único por página. */
  title: string;
  /** <meta name="description"> — 120-160 chars recomendado. */
  description: string;
  /** URL canónica. Por defecto: URL actual de la request. */
  canonical?: string | undefined;
  /** URL absoluta de la imagen Open Graph. Por defecto: se genera a partir de captura-video.webp. */
  ogImage?: string | undefined;
  /** Schema JSON-LD. Acepta un objeto o array de objetos. */
  jsonLd?: object | object[] | undefined;
  /** Clase extra para <body>, por si alguna página necesita override. */
  bodyClass?: string | undefined;
  /** Imagen LCP de la página. Si se provee, se inyecta <link rel="preload" as="image">. */
  lcpImage?: ImageMetadata | undefined;
  /** Anchos del <Image> LCP; deben coincidir con los de la página. */
  lcpWidths?: number[] | undefined;
  /** `sizes` del <Image> LCP; debe coincidir con el de la página. */
  lcpSizes?: string | undefined;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage,
  jsonLd,
  bodyClass,
  lcpImage,
  lcpWidths,
  lcpSizes,
} = Astro.props;

const siteOrigin = Astro.site?.origin ?? '';

// Imagen OG por defecto: se genera en build a 1200×630 (formato JPEG, el más compatible
// con WhatsApp/Facebook/X). Las páginas pueden pasar `ogImage` con una URL absoluta propia.
const ogFallback = await getImage({
  src: ogDefault,
  width: 1200,
  height: 630,
  fit: 'cover',
  position: 'center',
  format: 'jpg',
});
const ogImageUrl = ogImage ?? new URL(ogFallback.src, siteOrigin).href;

// Preload del LCP: hay que generar las MISMAS variantes que el <Image> de la página,
// o el navegador descarga una imagen de más (era el caso con `lcpImage.src`, el original).
const lcpPreload = lcpImage
  ? await getImage({
      src: lcpImage,
      widths: lcpWidths ?? [480, 768, 1024, 1400],
      sizes: lcpSizes ?? '100vw',
    })
  : null;

// JSON-LD: normaliza a array para el bucle
const jsonLdSchemas = jsonLd
  ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd])
  : [];

const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- SEO básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Manos dando un masaje californiano sobre la espalda en Voramà Terapias" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Voramà Terapias" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Manos dando un masaje californiano sobre la espalda en Voramà Terapias" />

    <!-- JSON-LD estructurado — is:inline porque lleva atributo type -->
    {jsonLdSchemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    ))}

    <!-- Preload de fuentes críticas (Inter + Brygada 1918) -->
    <link rel="preload" as="font" type="font/woff2" href={interFontUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={brygadaFontUrl} crossorigin />

    <!-- Preload de imagen LCP por página (opcional) -->
    {lcpPreload && (
      <link
        rel="preload"
        as="image"
        href={lcpPreload.src}
        imagesrcset={lcpPreload.srcSet.attribute}
        imagesizes={lcpSizes}
        fetchpriority="high"
      />
    )}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body class:list={[bodyClass]}>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppFloating />
    <BackToTop />
    <!-- ── Diálogos globales ────────────────────────────────── -->
    <BookingDialog />
  </body>
</html>
