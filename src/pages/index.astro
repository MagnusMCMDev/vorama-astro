---
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/sections/Section.astro';
import IconBox from '~/components/sections/IconBox.astro';
import Reviews from '~/components/sections/Reviews.astro';
import { SITE_CONFIG } from '~/config/site';

import homeHero from '~/assets/images/pages/home-hero.webp';
import videoPoster from '~/assets/images/pages/captura-video.webp';
import regalaBg from '~/assets/images/pages/regala-bg-home.webp';
import bgRelajante from '~/assets/images/pages/relajante-1.webp';
import bgCuatroManos from '~/assets/images/pages/4manos-paravertebrales.webp';
import bgParaDos from '~/assets/images/pages/faqs.webp';
import bgEventos from '~/assets/images/pages/playa-spa.webp';

const base = import.meta.env.BASE_URL;
const b = base.replace(/\/$/, '');

// JSON-LD LocalBusiness para SEO de portada
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HealthAndBeautyBusiness',
  name: SITE_CONFIG.name,
  description: SITE_CONFIG.description,
  url: SITE_CONFIG.url,
  telephone: SITE_CONFIG.telephone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE_CONFIG.address.street,
    addressLocality: SITE_CONFIG.address.locality,
    addressRegion: SITE_CONFIG.address.region,
    postalCode: SITE_CONFIG.address.postalCode,
    addressCountry: SITE_CONFIG.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: SITE_CONFIG.geo.latitude,
    longitude: SITE_CONFIG.geo.longitude,
  },
  openingHours: SITE_CONFIG.openingHours,
  sameAs: [SITE_CONFIG.social.instagram].filter(Boolean),
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: SITE_CONFIG.aggregateRating.ratingValue,
    reviewCount: SITE_CONFIG.aggregateRating.reviewCount,
    bestRating: SITE_CONFIG.aggregateRating.bestRating,
    worstRating: SITE_CONFIG.aggregateRating.worstRating,
  },
};
---

<BaseLayout
  title="Voramà Terapias — Masaje Californiano en Barcelona"
  description="Centro de masaje californiano en Barcelona. Sesiones individuales, en pareja, a cuatro manos y para eventos. Reserva online."
  jsonLd={jsonLd}
  lcpImage={homeHero}
>
  <!-- ── §1: Hero 2-column ───────────────────────────────────── -->
  <section class="hero" aria-label="Inicio">
    <div class="hero__inner">
      <div class="hero__content">
        <p class="hero__kicker">Bienvenido a Voramà Terapias</p>
        <h1 class="hero__title">Reconecta cuerpo y alma</h1>
        <a class="hero__cta" href={`${b}/servicios-masaje-californiano/#oferta-masaje`}>
          Reserva tu masaje ahora
        </a>
      </div>
      <figure class="hero__media">
        <Image
          src={homeHero}
          alt="Mano de terapeuta masajista pasando por la mano del paciente durante una sesión de Masaje Californiano."
          class="hero__img"
          widths={[480, 768, 1024, 1400]}
          sizes="(max-width: 800px) 100vw, 50vw"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
      <p class="hero__lead">
        Masaje californiano en Barcelona. Movimientos largos y envolventes para una relajación
        profunda del cuerpo y la mente.
      </p>
    </div>
  </section>

  <!-- ── §2: Un viaje + video + 3 IconBoxes ──────────────────── -->
  <Section variant="default" ariaLabel="Beneficios del masaje californiano">
    <header class="intro">
      <h2>Un viaje de experiencias a través del Masaje Californiano</h2>
    </header>

    <div class="video-wrap">
      <button
        type="button"
        class="video"
        data-video-id="uNqInMsaS4Y"
        aria-label="Reproducir video de presentación del Masaje Californiano"
      >
        <Image
          src={videoPoster}
          alt="Captura de video sobre Masaje Californiano: dos manos sobre la espalda con los pulgares presionando los paravertebrales."
          class="video__poster"
          widths={[600, 1024, 1400]}
          sizes="(max-width: 800px) 100vw, 900px"
        />
        <span class="video__play" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </span>
      </button>
    </div>

    <div class="benefits-grid">
      <IconBox icon="spa" title="Conexión Profunda" description="Fomenta una conexión integral entre cuerpo, mente y emociones para mayor autoconciencia." />
      <IconBox icon="hands" title="Máxima Relajación" description="Induce un estado de relajación total mediante movimientos largos y envolventes." />
      <IconBox icon="hands-wash" title="Libera Tensiones" description="Alivia tensiones físicas y emocionales acumuladas, promoviendo un bienestar integral." />
    </div>
  </Section>

  <!-- ── §3: Ofertas — 2x2 grid de 4 cards ───────────────────── -->
  <Section variant="muted" ariaLabel="Ofertas de masaje terapéutico">
    <header class="intro">
      <h2>Ofertas de masaje terapéutico</h2>
      <p>
        Relájate, conecta y transforma tu bienestar con nuestras experiencias de Masaje Californiano
        personalizadas.
      </p>
    </header>

    <div class="offers-2x2">
      <article class="offer-card">
        <Image src={bgRelajante} alt="Masaje californiano individual" class="offer-card__bg" widths={[400, 700]} sizes="(max-width: 800px) 100vw, 50vw" />
        <div class="offer-card__overlay" aria-hidden="true"></div>
        <div class="offer-card__content">
          <h3>Masaje Californiano</h3>
          <p>
            Una experiencia individual de profunda relajación y conexión corporal a través de
            movimientos fluidos y envolventes. Ideal para liberar tensiones, reconectar con uno
            mismo y disfrutar de un momento de máxima serenidad.
          </p>
          <p class="offer-card__price">Desde 60€</p>
          <a class="offer-card__btn" href={`${b}/masaje-californiano-relajante/#reserva`}>Reserva ahora</a>
        </div>
      </article>

      <article class="offer-card">
        <Image src={bgCuatroManos} alt="Masaje a cuatro manos" class="offer-card__bg" widths={[400, 700]} sizes="(max-width: 800px) 100vw, 50vw" />
        <div class="offer-card__overlay" aria-hidden="true"></div>
        <div class="offer-card__content">
          <h3>Masaje a Cuatro Manos</h3>
          <p>
            Dos terapeutas sincronizan sus movimientos en un masaje californiano, ofreciendo una
            experiencia multisensorial intensificada. Perfecto para quienes buscan una relajación
            profunda y la sensación de ser completamente envuelto en bienestar.
          </p>
          <p class="offer-card__price">Desde 100€</p>
          <a class="offer-card__btn" href={`${b}/masaje-californiano-cuatro-manos/#reserva`}>Reserva ahora</a>
        </div>
      </article>

      <article class="offer-card">
        <Image src={bgParaDos} alt="Masaje en pareja" class="offer-card__bg" widths={[400, 700]} sizes="(max-width: 800px) 100vw, 50vw" />
        <div class="offer-card__overlay" aria-hidden="true"></div>
        <div class="offer-card__content">
          <h3>Masaje para dos</h3>
          <p>
            Disfruta junto a tu ser querido de un masaje californiano en sincronía, cada uno con su
            propio terapeuta. Este masaje fomenta la conexión emocional y promueve la relajación
            compartida en un ambiente íntimo y armonioso.
          </p>
          <p class="offer-card__price">Desde 100€</p>
          <a class="offer-card__btn" href={`${b}/masaje-californiano-para-dos/#reserva`}>Reserva ahora</a>
        </div>
      </article>

      <article class="offer-card">
        <Image src={bgEventos} alt="Masaje en eventos y negocios" class="offer-card__bg" widths={[400, 700]} sizes="(max-width: 800px) 100vw, 50vw" />
        <div class="offer-card__overlay" aria-hidden="true"></div>
        <div class="offer-card__content">
          <h3>Servicio a Eventos y Negocios</h3>
          <p>
            Proporciona una experiencia de bienestar personalizada en eventos, retiros o negocios,
            transformando cualquier lugar en un espacio de relajación. Atrae clientes y
            participantes con un servicio adaptable que realza el ambiente general.
          </p>
          <div class="offer-card__ctas">
            <a class="offer-card__btn offer-card__btn--ghost" href={`${b}/servicios-masaje-eventos-negocios/`}>Información</a>
            <a class="offer-card__btn" href={`${b}/contacto/`}>Contacta</a>
          </div>
        </div>
      </article>
    </div>
  </Section>

  <!-- ── §4: Regala un Masaje ────────────────────────────────── -->
  <section class="regala-banner" aria-label="Regala un masaje">
    <Image src={regalaBg} alt="" class="regala-banner__bg" widths={[768, 1024, 1280, 1600, 1920]} sizes="100vw" loading="lazy" />
    <div class="regala-banner__overlay" aria-hidden="true"></div>
    <div class="regala-banner__content">
      <h2>Regala un Masaje</h2>
      <p>Sorprende a quienes más quieres con el regalo perfecto de relajación y bienestar.</p>
      <a class="regala-banner__btn" href={`${b}/regala-masaje/`}>Regalar Masaje</a>
    </div>
  </section>

  <!-- ── §5: Reviews ─────────────────────────────────────────── -->
  <Section variant="default" ariaLabel="Reseñas de Google">
    <Reviews variant="bubble" count={3} showHeader={true} />
  </Section>
</BaseLayout>

<style>
  /* ── Hero 2-column ───────────────────────────────────────── */
  .hero {
    background: linear-gradient(135deg, var(--vrm-color-bg-subtle) 0%, var(--vrm-color-bg-alt) 100%);
    /* Sube bajo el header translúcido para que su fondo cremoso
       se blurree por detrás en lugar de ver una franja blanca. */
    margin-top: calc(var(--vrm-header-height) * -1);
    padding-top: calc(var(--vrm-space-2xl) + var(--vrm-header-height));
    padding-bottom: var(--vrm-space-2xl);
  }

  .hero__inner {
    max-width: var(--vrm-container-width);
    margin-inline: auto;
    padding-inline: var(--vrm-space-lg);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--vrm-space-xl);
    align-items: center;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero__kicker {
    font-family: var(--vrm-font-body);
    font-size: var(--vrm-font-size-sm);
    font-weight: var(--vrm-font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--vrm-color-primary);
    margin-bottom: var(--vrm-space-md);
  }

  .hero__title {
    font-size: clamp(var(--vrm-font-size-3xl), 5.5vw, var(--vrm-font-size-4xl));
    line-height: var(--vrm-line-height-tight);
    color: var(--vrm-color-primary);
    margin-bottom: var(--vrm-space-md);
    text-wrap: balance;
    max-width: 14ch;
  }

  .hero__lead {
    /* Texto secundario (SEO). Va debajo del contenido principal,
       cruzando las dos columnas del grid en desktop. */
    grid-column: 1 / -1;
    margin: var(--vrm-space-lg) auto 0;
    max-width: 60ch;
    text-align: center;
    text-wrap: balance;
    font-size: var(--vrm-font-size-xs);
    line-height: var(--vrm-line-height-relaxed);
    color: var(--vrm-color-text-muted);
    font-style: italic;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    padding: var(--vrm-space-sm) var(--vrm-space-lg);
    background-color: var(--vrm-color-primary);
    color: var(--vrm-color-text-inverted);
    font-weight: var(--vrm-font-weight-semibold);
    border-radius: var(--vrm-radius-full);
    text-decoration: none;
    box-shadow: 0 4px 12px rgb(32 91 79 / 0.25);
    transition: background-color var(--vrm-transition-fast), transform var(--vrm-transition-fast), box-shadow var(--vrm-transition-fast);
  }

  .hero__cta:hover,
  .hero__cta:focus-visible {
    background-color: var(--vrm-color-primary-light);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgb(32 91 79 / 0.35);
    color: var(--vrm-color-text-inverted);
    text-decoration: none;
  }

  .hero__media {
    margin: 0;
  }

  .hero__img {
    width: 100%;
    max-width: 480px;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center;
    border-radius: 50%;
    box-shadow: 0 24px 48px -16px rgb(32 91 79 / 0.35);
    display: block;
    margin-inline: auto;
  }

  /* ── Intro ────────────────────────────────────────────────── */
  .intro {
    text-align: center;
    max-width: 720px;
    margin: 0 auto var(--vrm-space-xl);
  }

  .intro h2 {
    color: var(--vrm-color-primary);
    margin-bottom: var(--vrm-space-md);
  }

  /* ── Video poster ─────────────────────────────────────────── */
  .video-wrap {
    max-width: 900px;
    margin: 0 auto var(--vrm-space-2xl);
  }

  .video {
    position: relative;
    display: block;
    width: 100%;
    border-radius: var(--vrm-radius-lg);
    overflow: hidden;
    box-shadow: var(--vrm-shadow-md);
    aspect-ratio: 16 / 9;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
  }

  /* iframe que reemplaza al poster cuando el usuario pulsa play */
  .video__iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video__poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--vrm-transition-base);
  }

  .video:hover .video__poster,
  .video:focus-visible .video__poster {
    transform: scale(1.03);
  }

  .video__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    background: rgb(0 0 0 / 0.25);
    transition: background-color var(--vrm-transition-fast);
  }

  .video__play svg {
    background: rgb(32 91 79 / 0.85);
    border-radius: 50%;
    padding: 12px;
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.3);
  }

  .video:hover .video__play,
  .video:focus-visible .video__play {
    background: rgb(0 0 0 / 0.35);
  }

  /* ── Benefits ─────────────────────────────────────────────── */
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--vrm-space-lg);
  }

  /* ── Offers 2×2 grid ──────────────────────────────────────── */
  .offers-2x2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--vrm-space-lg);
    max-width: 1100px;
    margin-inline: auto;

    @media (max-width: 800px) {
      grid-template-columns: 1fr;
    }
  }

  .offer-card {
    position: relative;
    display: flex;
    overflow: hidden;
    border-radius: var(--vrm-radius-lg);
    box-shadow: var(--vrm-shadow-md);
    min-height: 380px;
    isolation: isolate;
  }

  .offer-card__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    /* Zoom largo y suave: 1.6s con curva ease-out (igual que CardCTA). */
    transition: transform 1600ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .offer-card:hover .offer-card__bg,
  .offer-card:focus-within .offer-card__bg,
  .offer-card:active .offer-card__bg {
    transform: scale(1.14);
  }

  .offer-card__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0) 0%,
      rgb(0 0 0 / 0.18) 55%,
      rgb(0 0 0 / 0.45) 100%
    );
  }

  .offer-card__content {
    position: relative;
    z-index: 2;
    padding: var(--vrm-space-lg);
    color: #fff;
    display: flex;
    flex-direction: column;
    gap: var(--vrm-space-sm);
    width: 100%;
    text-shadow: 0 1px 4px rgb(0 0 0 / 0.7), 0 0 16px rgb(0 0 0 / 0.4);
  }

  .offer-card__content h3 {
    color: #fff;
    margin: 0 0 var(--vrm-space-xs);
    font-size: var(--vrm-font-size-2xl);
  }

  .offer-card__content p {
    margin: 0;
    line-height: var(--vrm-line-height-body);
    font-size: var(--vrm-font-size-sm);
  }

  .offer-card__price {
    font-family: var(--vrm-font-display);
    font-size: var(--vrm-font-size-2xl);
    font-weight: var(--vrm-font-weight-semibold);
    color: #fff;
    margin: auto 0 var(--vrm-space-xs);
    letter-spacing: 0.02em;
  }

  .offer-card__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--vrm-space-sm);
    margin-top: auto;
  }

  .offer-card__btn {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    padding: var(--vrm-space-xs) var(--vrm-space-md);
    background-color: #fff;
    color: var(--vrm-color-primary);
    font-size: var(--vrm-font-size-sm);
    font-weight: var(--vrm-font-weight-semibold);
    border: 2px solid #fff;
    border-radius: var(--vrm-radius-full);
    text-decoration: none;
    text-shadow: none;
    transition: background-color var(--vrm-transition-fast), color var(--vrm-transition-fast);
    margin-top: var(--vrm-space-sm);
  }

  .offer-card__btn:hover,
  .offer-card__btn:focus-visible {
    background-color: var(--vrm-color-primary);
    color: var(--vrm-color-text-inverted);
    border-color: var(--vrm-color-primary);
    text-decoration: none;
  }

  .offer-card__btn--ghost {
    background-color: transparent;
    color: #fff;
  }

  .offer-card__btn--ghost:hover,
  .offer-card__btn--ghost:focus-visible {
    background-color: #fff;
    color: var(--vrm-color-primary);
    border-color: #fff;
  }

  /* ── Banner regala ───────────────────────────────────────── */
  .regala-banner {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    min-height: 360px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .regala-banner__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .regala-banner__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.1) 0%,
      rgb(0 0 0 / 0.32) 100%
    );
  }

  .regala-banner__content {
    position: relative;
    z-index: 2;
    padding: var(--vrm-space-2xl) var(--vrm-space-lg);
    color: #fff;
    text-align: center;
    max-width: 640px;
    text-shadow: 0 1px 4px rgb(0 0 0 / 0.7), 0 0 14px rgb(0 0 0 / 0.4);
  }

  .regala-banner__content h2 {
    color: #fff;
    margin-bottom: var(--vrm-space-md);
    font-size: clamp(var(--vrm-font-size-2xl), 4vw, var(--vrm-font-size-3xl));
  }

  .regala-banner__content p {
    color: rgb(255 255 255 / 0.95);
    margin-bottom: var(--vrm-space-lg);
    font-size: var(--vrm-font-size-md);
  }

  .regala-banner__btn {
    display: inline-flex;
    align-items: center;
    padding: var(--vrm-space-sm) var(--vrm-space-xl);
    background-color: #fff;
    color: var(--vrm-color-primary);
    font-weight: var(--vrm-font-weight-semibold);
    font-size: var(--vrm-font-size-base);
    border-radius: var(--vrm-radius-full);
    text-decoration: none;
    text-shadow: none;
    box-shadow: 0 6px 16px rgb(0 0 0 / 0.25);
    transition: background-color var(--vrm-transition-fast), transform var(--vrm-transition-fast), color var(--vrm-transition-fast);
  }

  .regala-banner__btn:hover,
  .regala-banner__btn:focus-visible {
    background-color: var(--vrm-color-primary);
    color: var(--vrm-color-text-inverted);
    transform: translateY(-2px);
    text-decoration: none;
  }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 800px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--vrm-space-lg);
    }
    /* Mantener orden de la web origen en mobile:
       texto + CTA arriba, imagen debajo. */
  }
</style>

<script>
  // YouTube facade: al pulsar el poster, se reemplaza por un iframe
  // que reproduce el video sin sacar al usuario de la web.
  // Esto mantiene la página ligera (no carga el iframe de YT hasta
  // que el usuario lo solicita).
  document.querySelectorAll<HTMLButtonElement>('.video[data-video-id]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.videoId;
      if (!id) return;
      // Iframe con autoplay + dominio nocookie (privacy-enhanced).
      // Estilos en línea para garantizar que ocupe todo el wrapper
      // independientemente del scoping CSS de Astro (los selectores
      // .video / .video__iframe se compilan con data-astro-cid-XXX).
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
      iframe.title = 'Video de presentación de Voramà — Masaje Californiano';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.setAttribute('allowfullscreen', '');
      iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
      iframe.style.cssText =
        'position:absolute;inset:0;width:100%;height:100%;border:0;display:block;';

      // Envolvemos el iframe en un div del mismo tamaño/forma que el
      // botón anterior. Inline styles para no depender del CSS scoped.
      const wrapper = document.createElement('div');
      wrapper.style.cssText =
        'position:relative;width:100%;aspect-ratio:16/9;border-radius:var(--vrm-radius-lg);overflow:hidden;box-shadow:var(--vrm-shadow-md);';
      wrapper.appendChild(iframe);
      btn.replaceWith(wrapper);
    });
  });
</script>
