---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/sections/PageHeader.astro';
import Section from '~/components/sections/Section.astro';
import IconBox from '~/components/sections/IconBox.astro';
import ContactForm from '~/components/interactive/ContactForm.astro';
import MapEmbed from '~/components/sections/MapEmbed.astro';
---

<BaseLayout
  title="Contacto — Voramà Terapias"
  description="Contacta con Voramà Terapias para reservar tu masaje californiano en Barcelona. Email, WhatsApp, Instagram y formulario."
>
  <PageHeader title="Contacto" />

  <!-- ── Medios de contacto ───────────────────────────────────── -->
  <Section variant="default" ariaLabel="Medios de contacto">
    <h2 style="text-align:center; margin-bottom: var(--vrm-space-xl)">
      Puedes contactar conmigo a través de los siguientes medios:
    </h2>
    <div class="contact-channels">
      <IconBox
        icon="mail"
        title="vorama.terapias@gmail.com"
        description="Escríbeme un correo"
        href="mailto:vorama.terapias@gmail.com"
      />
      <IconBox
        icon="whatsapp"
        title="WhatsApp"
        description="+34 623 94 18 91"
        href="https://api.whatsapp.com/send?phone=+34623941891&text=Quiero%20m%C3%A1s%20informaci%C3%B3n"
      />
      <IconBox
        icon="instagram"
        title="@vorama.terapias"
        description="Sígueme en Instagram"
        href="https://www.instagram.com/vorama.terapias/"
      />
    </div>
  </Section>

  <!-- ── Formulario ───────────────────────────────────────────── -->
  <Section variant="muted" ariaLabel="Formulario de contacto">
    <h2 style="text-align:center; margin-bottom: var(--vrm-space-xl)">
      Para más consultas rellena el siguiente formulario:
    </h2>
    <div class="contact-form-wrap">
      <ContactForm variant="contacto" id="contacto-form" />
    </div>
  </Section>

  <!-- ── Mapas / ubicaciones ──────────────────────────────────── -->
  <Section variant="default" ariaLabel="Ubicaciones">
    <h2 style="text-align:center; margin-bottom: var(--vrm-space-xl)">Mis ubicaciones:</h2>
    <div class="locations">
      <article class="location">
        <h3 class="location__title">Masaje Californiano | Voramà</h3>
        <address class="location__address">
          Carrer de Sant Antoni Maria Claret, 51, local 3 Despacho 3<br />
          Gracia, 08025 Barcelona<br />
          <a href="tel:+34623941891">623 941 891</a>
        </address>
        <MapEmbed query="Carrer de Sant Antoni Maria Claret 51, Barcelona" title="Voramà — Sant Antoni Maria Claret 51" />
      </article>

      <article class="location">
        <h3 class="location__title">Més Millor</h3>
        <address class="location__address">
          C/ de Felip II, 23, entr 4<br />
          San Andrés de Palomar, 08027 Barcelona
        </address>
        <MapEmbed query="C/ de Felip II, 23, Barcelona" title="Més Millor — Felip II 23" />
      </article>
    </div>
  </Section>
</BaseLayout>

<style>
  .contact-channels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--vrm-space-md);
    max-width: 900px;
    margin-inline: auto;
  }

  .contact-form-wrap {
    max-width: 720px;
    margin-inline: auto;
  }

  .locations {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--vrm-space-xl);

    @media (max-width: 800px) {
      grid-template-columns: 1fr;
    }
  }

  .location {
    display: flex;
    flex-direction: column;
    gap: var(--vrm-space-md);
  }

  .location__title {
    color: var(--vrm-color-primary);
    margin: 0;
  }

  .location__address {
    font-style: normal;
    line-height: var(--vrm-line-height-relaxed);
    margin: 0;

    & a {
      color: var(--vrm-color-primary);
      font-weight: var(--vrm-font-weight-semibold);
    }
  }

</style>
