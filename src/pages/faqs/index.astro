---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/sections/PageHeader.astro';
import Section from '~/components/sections/Section.astro';
import AccordionFAQ from '~/components/sections/AccordionFAQ.astro';

const allFaqs = (await getCollection('faqs')).sort((a, b) => a.data.order - b.data.order);

type Group = 'californiano' | 'pareja' | 'cuatro-manos' | 'regala';

function pick(group: Group) {
  return allFaqs
    .filter((f) => f.data.group === group)
    .map((f) => ({ question: f.data.question, answer: f.data.answer }));
}

const faqsCalifo = pick('californiano');
const faqsPareja = pick('pareja');
const faqs4Manos = pick('cuatro-manos');
const faqsRegala = pick('regala');

// JSON-LD FAQPage para SEO
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allFaqs.map((f) => ({
    '@type': 'Question',
    name: f.data.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.data.answer,
    },
  })),
};
---

<BaseLayout
  title="Preguntas Frecuentes — Voramà Terapias"
  description="Resolvemos tus dudas sobre el masaje californiano: beneficios, contraindicaciones, sesiones individuales, en pareja, a cuatro manos y vales regalo."
  jsonLd={faqJsonLd}
>
  <PageHeader title="Preguntas Frecuentes" />

  <Section variant="default" ariaLabel="FAQs masaje californiano">
    <div class="faqs-wrap">
      <h2>Masaje Californiano</h2>
      <AccordionFAQ items={faqsCalifo} exclusive={true} />
    </div>
  </Section>

  <Section variant="muted" ariaLabel="FAQs masaje en pareja">
    <div class="faqs-wrap">
      <h2>Masaje en Pareja</h2>
      <AccordionFAQ items={faqsPareja} exclusive={true} />
    </div>
  </Section>

  <Section variant="default" ariaLabel="FAQs masaje a cuatro manos">
    <div class="faqs-wrap">
      <h2>Masaje a Cuatro Manos</h2>
      <AccordionFAQ items={faqs4Manos} exclusive={true} />
    </div>
  </Section>

  <Section variant="muted" ariaLabel="FAQs regala masaje">
    <div class="faqs-wrap">
      <h2>Regala Masaje</h2>
      <AccordionFAQ items={faqsRegala} exclusive={true} />
    </div>
  </Section>
</BaseLayout>

<style>
  .faqs-wrap {
    max-width: 900px;
    margin-inline: auto;
  }

  .faqs-wrap h2 {
    color: var(--vrm-color-primary);
    margin-bottom: var(--vrm-space-lg);
    text-align: center;
  }
</style>
