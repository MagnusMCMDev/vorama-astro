---
interface Props {
  /** 'contacto' — formulario general | 'regala' — solicitar vale regalo */
  variant?: 'contacto' | 'regala';
  /** ID único del form; útil si hay más de uno en la misma página. */
  id?: string;
}

const { variant = 'contacto', id = 'contact-form' } = Astro.props;
const isRegala = variant === 'regala';

// Claves Web3Forms por variante
const ACCESS_KEYS: Record<string, string> = {
  contacto: '79f5b132-ba65-4e68-a6f7-cac85dedd3a2',
  regala:   'fe240b7c-15b5-4bab-bb92-26f3065003a8',
};
const accessKey = ACCESS_KEYS[variant];
---

<div class="cf-wrap" data-cf-wrap id={`${id}-wrap`}>

  <!-- ── Formulario ──────────────────────────────────────────── -->
  <form
    class="contact-form"
    id={id}
    novalidate
    aria-label={isRegala ? 'Solicitar vale regalo' : 'Formulario de contacto'}
    data-form-id={id}
    data-access-key={accessKey}
    data-is-regala={isRegala ? 'true' : undefined}
  >

    <!-- Honeypot anti-spam (Web3Forms lo detecta nativamente) -->
    <input type="checkbox" name="botcheck" class="contact-form__botcheck" tabindex="-1" autocomplete="off" />

    <!-- Nombre + Apellidos -->
    <div class="contact-form__row">
      <div class="contact-form__field">
        <label class="contact-form__label" for={`${id}-nombre`}>
          Nombre <span class="contact-form__required" aria-hidden="true">*</span>
        </label>
        <input
          class="contact-form__input"
          type="text"
          id={`${id}-nombre`}
          name="nombre"
          required
          autocomplete="given-name"
          aria-required="true"
        />
      </div>
      <div class="contact-form__field">
        <label class="contact-form__label" for={`${id}-apellidos`}>
          Apellidos <span class="contact-form__required" aria-hidden="true">*</span>
        </label>
        <input
          class="contact-form__input"
          type="text"
          id={`${id}-apellidos`}
          name="apellidos"
          required
          autocomplete="family-name"
          aria-required="true"
        />
      </div>
    </div>

    <!-- Email + Teléfono -->
    <div class="contact-form__row">
      <div class="contact-form__field">
        <label class="contact-form__label" for={`${id}-email`}>
          Correo electrónico <span class="contact-form__required" aria-hidden="true">*</span>
        </label>
        <input
          class="contact-form__input"
          type="email"
          id={`${id}-email`}
          name="email"
          required
          autocomplete="email"
          aria-required="true"
          inputmode="email"
        />
      </div>
      <div class="contact-form__field">
        <label class="contact-form__label" for={`${id}-telefono`}>
          Teléfono
        </label>
        <input
          class="contact-form__input"
          type="tel"
          id={`${id}-telefono`}
          name="telefono"
          autocomplete="tel"
          inputmode="tel"
        />
      </div>
    </div>

    <!-- Mensaje / Comentario -->
    <div class="contact-form__field">
      <label class="contact-form__label" for={`${id}-mensaje`}>
        {isRegala ? 'Mensaje para el destinatario (opcional)' : 'Comentario o pregunta'}
      </label>
      <textarea
        class="contact-form__input contact-form__textarea"
        id={`${id}-mensaje`}
        name="mensaje"
        rows="4"
      ></textarea>
    </div>

    <!-- Privacidad -->
    <div class="contact-form__field contact-form__field--check">
      <input
        class="contact-form__checkbox"
        type="checkbox"
        id={`${id}-privacidad`}
        name="privacidad"
        required
        aria-required="true"
      />
      <label class="contact-form__label contact-form__label--check" for={`${id}-privacidad`}>
        He leído y acepto la
        <button type="button" class="contact-form__link" data-dialog="dialog-privacidad">
          política de privacidad
        </button>
        <span class="contact-form__required" aria-hidden="true">*</span>
      </label>
    </div>

    <!-- Error de validación -->
    <div
      class="contact-form__error"
      id={`${id}-error`}
      role="alert"
      aria-live="assertive"
      hidden
    ></div>

    <!-- Submit -->
    <button type="submit" class="contact-form__submit" data-submit-btn>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        aria-hidden="true"
        focusable="false"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M22 2L11 13" />
        <path d="M22 2L15 22L11 13L2 9L22 2Z" />
      </svg>
      {isRegala ? 'Solicitar vale regalo' : 'Enviar mensaje'}
    </button>

    <p class="contact-form__note">
      Recibirás respuesta en un máximo de 24 horas.
    </p>
  </form>

  <!-- ── Estado: enviando ──────────────────────────────────────── -->
  <div class="cf-feedback cf-feedback--sending" id={`${id}-sending`} hidden aria-live="polite">
    <span class="cf-spinner" aria-hidden="true"></span>
    <p>Enviando...</p>
  </div>

  <!-- ── Estado: éxito ─────────────────────────────────────────── -->
  <div class="cf-feedback cf-feedback--success" id={`${id}-success`} hidden aria-live="polite">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="48"
      height="48"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="10" />
      <path d="M9 12l2 2 4-4" />
    </svg>
    <h3>¡Mensaje enviado!</h3>
    <p>
      {isRegala
        ? 'Hemos recibido tu solicitud de vale regalo. Te contactaremos en menos de 24 horas para darte todos los detalles.'
        : 'Hemos recibido tu mensaje. Te responderemos en menos de 24 horas.'}
    </p>
  </div>

  <!-- ── Estado: error ─────────────────────────────────────────── -->
  <div class="cf-feedback cf-feedback--error" id={`${id}-fail`} hidden>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="48"
      height="48"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="10" />
      <line x1="12" y1="8" x2="12" y2="12" />
      <line x1="12" y1="16" x2="12.01" y2="16" />
    </svg>
    <h3>No se pudo enviar</h3>
    <p>
      Ha ocurrido un error. Por favor, inténtalo de nuevo o
      <a href="https://wa.me/34623941891" target="_blank" rel="noopener noreferrer">
        escríbenos por WhatsApp
      </a>.
    </p>
    <button type="button" class="contact-form__retry" data-retry-btn>
      Intentar de nuevo
    </button>
  </div>

</div>

<style>
  /* ── Wrapper (gestiona visibilidad de estados) ───────────── */
  .cf-wrap {
    position: relative;
  }

  /* ── Formulario ──────────────────────────────────────────── */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--vrm-space-md);
  }

  /* Ocultar honeypot */
  .contact-form__botcheck {
    position: absolute;
    left: -9999px;
    opacity: 0;
    pointer-events: none;
    tabindex: -1;
  }

  /* ── Fila doble ──────────────────────────────────────────── */
  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--vrm-space-md);

    @media (max-width: 500px) {
      grid-template-columns: 1fr;
    }
  }

  /* ── Campo individual ────────────────────────────────────── */
  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--vrm-space-xs);
  }

  .contact-form__field--check {
    flex-direction: row;
    align-items: flex-start;
    gap: var(--vrm-space-sm);
  }

  /* ── Labels ──────────────────────────────────────────────── */
  .contact-form__label {
    font-size: var(--vrm-font-size-sm);
    font-weight: var(--vrm-font-weight-semibold);
    color: var(--vrm-color-text);
  }

  .contact-form__label--check {
    font-size: var(--vrm-font-size-sm);
    font-weight: var(--vrm-font-weight-normal);
    cursor: pointer;
    line-height: 1.5;
  }

  .contact-form__required {
    color: #c0392b;
    margin-left: 1px;
  }

  /* ── Inputs ──────────────────────────────────────────────── */
  .contact-form__input {
    width: 100%;
    padding: var(--vrm-space-sm) var(--vrm-space-md);
    font-family: var(--vrm-font-body);
    font-size: var(--vrm-font-size-base);
    color: var(--vrm-color-text);
    background-color: var(--vrm-color-bg);
    border: 1px solid var(--vrm-color-border);
    border-radius: var(--vrm-radius-md);
    transition: border-color var(--vrm-transition-fast), box-shadow var(--vrm-transition-fast);
    appearance: none;

    &:hover {
      border-color: var(--vrm-color-border-strong);
    }

    &:focus-visible {
      outline: none;
      border-color: var(--vrm-color-primary);
      box-shadow: 0 0 0 3px rgb(32 91 79 / 0.15);
    }

    &:invalid:not(:placeholder-shown) {
      border-color: #c0392b;
    }
  }

  .contact-form__textarea {
    resize: vertical;
    min-height: 96px;
  }

  /* ── Checkbox ────────────────────────────────────────────── */
  .contact-form__checkbox {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    accent-color: var(--vrm-color-primary);
    cursor: pointer;
  }

  /* ── Enlace inline (política de privacidad) ──────────────── */
  .contact-form__link {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
    color: var(--vrm-color-primary);
    font-weight: var(--vrm-font-weight-semibold);
    text-decoration: underline;
    cursor: pointer;

    &:hover,
    &:focus-visible {
      color: var(--vrm-color-primary-light);
    }

    &:focus-visible {
      outline: 2px solid var(--vrm-color-primary);
      outline-offset: 2px;
      border-radius: 2px;
    }
  }

  /* ── Error validación ────────────────────────────────────── */
  .contact-form__error {
    padding: var(--vrm-space-sm) var(--vrm-space-md);
    border-radius: var(--vrm-radius-md);
    background-color: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
    font-size: var(--vrm-font-size-sm);
    line-height: 1.5;
  }

  /* ── Botón submit ────────────────────────────────────────── */
  .contact-form__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--vrm-space-sm);
    padding: var(--vrm-space-sm) var(--vrm-space-lg);
    background-color: var(--vrm-color-primary);
    color: var(--vrm-color-text-inverted);
    font-family: var(--vrm-font-body);
    font-size: var(--vrm-font-size-base);
    font-weight: var(--vrm-font-weight-semibold);
    border: none;
    border-radius: var(--vrm-radius-full);
    cursor: pointer;
    transition: background-color var(--vrm-transition-fast);

    &:hover,
    &:focus-visible {
      background-color: var(--vrm-color-primary-light);
    }

    &:focus-visible {
      outline: 2px solid var(--vrm-color-primary);
      outline-offset: 3px;
    }

    &:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
  }

  /* ── Nota informativa ────────────────────────────────────── */
  .contact-form__note {
    font-size: var(--vrm-font-size-xs);
    color: var(--vrm-color-text-muted);
    text-align: center;
    margin: 0;
    line-height: 1.5;
  }

  /* ── Estados feedback ────────────────────────────────────── */
  .cf-feedback {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--vrm-space-md);
    padding: var(--vrm-space-2xl) var(--vrm-space-lg);
    text-align: center;
    min-height: 280px;
  }

  .cf-feedback h3 {
    margin: 0;
    font-size: var(--vrm-font-size-xl);
    color: var(--vrm-color-text);
  }

  .cf-feedback p {
    margin: 0;
    line-height: var(--vrm-line-height-relaxed);
    color: var(--vrm-color-text-muted);
    max-width: 420px;

    & a {
      color: var(--vrm-color-primary);
      font-weight: var(--vrm-font-weight-semibold);
    }
  }

  /* Éxito — icono verde */
  .cf-feedback--success svg {
    color: var(--vrm-color-primary);
  }

  /* Error — icono rojo */
  .cf-feedback--error svg {
    color: #dc2626;
  }

  /* Botón reintentar */
  .contact-form__retry {
    margin-top: var(--vrm-space-sm);
    padding: var(--vrm-space-xs) var(--vrm-space-lg);
    background: none;
    border: 2px solid var(--vrm-color-primary);
    border-radius: var(--vrm-radius-full);
    color: var(--vrm-color-primary);
    font-family: var(--vrm-font-body);
    font-size: var(--vrm-font-size-sm);
    font-weight: var(--vrm-font-weight-semibold);
    cursor: pointer;
    transition: background-color var(--vrm-transition-fast), color var(--vrm-transition-fast);

    &:hover,
    &:focus-visible {
      background-color: var(--vrm-color-primary);
      color: var(--vrm-color-text-inverted);
    }

    &:focus-visible {
      outline: 2px solid var(--vrm-color-primary);
      outline-offset: 3px;
    }
  }

  /* Spinner de carga */
  .cf-spinner {
    display: inline-block;
    width: 36px;
    height: 36px;
    border: 3px solid rgb(32 91 79 / 0.2);
    border-top-color: var(--vrm-color-primary);
    border-radius: 50%;
    animation: cf-spin 0.8s linear infinite;
  }

  @keyframes cf-spin {
    to { transform: rotate(360deg); }
  }

  .cf-feedback--sending p {
    color: var(--vrm-color-text-muted);
    font-size: var(--vrm-font-size-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-form__input,
    .contact-form__submit,
    .contact-form__retry {
      transition: none;
    }
    .cf-spinner {
      animation: none;
      border-top-color: var(--vrm-color-primary);
    }
  }
</style>

<script>
  const W3F_URL = 'https://api.web3forms.com/submit';

  document.querySelectorAll<HTMLFormElement>('form.contact-form').forEach((form) => {
    const formId    = form.dataset.formId ?? form.id;
    const isRegala  = form.dataset.isRegala === 'true';
    const accessKey = form.dataset.accessKey ?? '';
    const errorEl   = document.getElementById(`${formId}-error`);
    const sendingEl = document.getElementById(`${formId}-sending`);
    const successEl = document.getElementById(`${formId}-success`);
    const failEl    = document.getElementById(`${formId}-fail`);

    function showError(msg: string): void {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.removeAttribute('hidden');
      errorEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function hideError(): void {
      errorEl?.setAttribute('hidden', '');
    }

    function setState(state: 'form' | 'sending' | 'success' | 'fail'): void {
      form.hidden         = state !== 'form';
      sendingEl!.hidden   = state !== 'sending';
      successEl!.hidden   = state !== 'success';
      failEl!.hidden      = state !== 'fail';
      // Foco al feedback para lectores de pantalla
      if (state === 'success') successEl?.focus();
      if (state === 'fail')    failEl?.focus();
    }

    // Botón "Intentar de nuevo" restaura el formulario
    failEl?.querySelector('[data-retry-btn]')?.addEventListener('click', () => {
      setState('form');
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const data       = new FormData(form);
      const nombre     = data.get('nombre')?.toString().trim()     ?? '';
      const apellidos  = data.get('apellidos')?.toString().trim()  ?? '';
      const email      = data.get('email')?.toString().trim()      ?? '';
      const telefono   = data.get('telefono')?.toString().trim()   ?? '';
      const mensaje    = data.get('mensaje')?.toString().trim()    ?? '';
      const privacidad = data.get('privacidad');
      const botcheck   = (form.querySelector<HTMLInputElement>('[name="botcheck"]'))?.checked ?? false;

      // Validación
      if (!nombre || nombre.length < 2) {
        showError('Por favor, introduce tu nombre (mínimo 2 caracteres).');
        return;
      }
      if (!apellidos) {
        showError('Por favor, introduce tus apellidos.');
        return;
      }
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError('Por favor, introduce un correo electrónico válido.');
        return;
      }
      if (!privacidad) {
        showError('Debes aceptar la política de privacidad para continuar.');
        return;
      }

      hideError();
      setState('sending');

      const subject = isRegala
        ? `[Voramà] Solicitud de vale regalo — ${nombre} ${apellidos}`
        : `[Voramà] Consulta de contacto — ${nombre} ${apellidos}`;

      const lines = [
        `Nombre: ${nombre} ${apellidos}`,
        `Email: ${email}`,
        telefono ? `Teléfono: ${telefono}` : null,
        mensaje  ? `\nMensaje:\n${mensaje}` : null,
      ].filter(Boolean).join('\n');

      try {
        const res = await fetch(W3F_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({
            access_key: accessKey,
            subject,
            from_name:  `${nombre} ${apellidos}`,
            replyto:    email,
            botcheck:   botcheck ? 'true' : '',
            message:    lines,
          }),
        });

        const json = await res.json().catch(() => ({}));
        if (res.ok && json.success) {
          setState('success');
        } else {
          console.error('[ContactForm] Web3Forms error', json);
          setState('fail');
        }
      } catch (err) {
        console.error('[ContactForm] fetch error', err);
        setState('fail');
      }
    });
  });
</script>
