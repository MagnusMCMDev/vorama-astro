---

<Tag
  class:list={['icon-box', href && 'icon-box--link']}
  href={href}
  {...(href ? { target: href.startsWith('http') ? '_blank' : undefined, rel: href.startsWith('http') ? 'noopener noreferrer' : undefined } : {})}
>
  <span class="icon-box__icon" aria-hidden="true">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox={def.viewBox}
      width="40"
      height="40"
      aria-hidden="true"
      focusable="false"
      set:html={def.path}
    />
  </span>
  <div class="icon-box__body">
    <p class="icon-box__title">{title}</p>
    {description && <p class="icon-box__desc">{description}</p>}
  </div>
</Tag>

<style>
  .icon-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--vrm-space-md);
    padding: var(--vrm-space-md);
    border-radius: var(--vrm-radius-md);
    text-align: center;
  }

  .icon-box--link {
    text-decoration: none;
    color: inherit;
    transition: background-color var(--vrm-transition-fast);

    &:hover,
    &:focus-visible {
      background-color: var(--vrm-color-bg-subtle);
      text-decoration: none;
      color: inherit;
    }
  }

  .icon-box__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    background-color: var(--vrm-color-bg-subtle);
    border-radius: 50%;
    color: var(--vrm-color-primary);
    transition: transform var(--vrm-transition-base);
  }

  .icon-box__icon svg {
    width: 40px;
    height: 40px;
    display: block;
  }

  .icon-box:hover .icon-box__icon {
    transform: translateY(-2px);
  }

  .icon-box__body {
    display: flex;
    flex-direction: column;
    gap: var(--vrm-space-xs);
    max-width: 32ch;
  }

  .icon-box__title {
    font-weight: var(--vrm-font-weight-semibold);
