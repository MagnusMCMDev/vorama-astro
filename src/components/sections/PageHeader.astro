---
/**
 * PageHeader — hero compacto sin imagen, fondo degradado.
 * Para páginas internas donde el "hero" del WP era solo texto sobre gradient.
 */
interface Props {
  kicker?: string | undefined;
  title: string;
  lead?: string | undefined;
}

const { kicker, title, lead } = Astro.props;
---

<header class="page-header">
  <div class="page-header__inner">
    {kicker && <p class="page-header__kicker">{kicker}</p>}
    <h1 class="page-header__title">{title}</h1>
    {lead && <p class="page-header__lead">{lead}</p>}
  </div>
</header>

<style>
  .page-header {
    /* Doble capa:
       1. Halo claro saliendo de la esquina superior izquierda
          (donde está el header translúcido — para que destaque).
       2. Degradado diagonal que va de verde claro (TL) a verde
          muy oscuro (BR), con contraste acusado. */
    background:
      radial-gradient(
        ellipse 90% 110% at 0% -10%,
        rgb(190 235 218 / 0.85) 0%,
        rgb(120 200 178 / 0.45) 30%,
        transparent 65%
      ),
      linear-gradient(
        135deg,
        #5aa896 0%,
        #3a8675 22%,
        var(--vrm-color-primary) 55%,
        #14463c 82%,
        #08231d 100%
      );
    color: var(--vrm-color-text-inverted);
    /* La sección sube bajo el header translúcido: su fondo se
       blurrea por detrás integrándose con el header. El padding-top
       extra clarea el contenido del título debajo del header. */
    margin-top: calc(var(--vrm-header-height) * -1);
    padding-top: calc(var(--vrm-space-2xl) + var(--vrm-header-height));
    padding-bottom: var(--vrm-space-2xl);
    text-align: center;
    position: relative;
  }

  /* Capa sutil que asegura legibilidad del título sobre el gradient
     cálido del bottom-right (donde el verde se aclara más). */
  .page-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 60% 70% at 50% 50%,
      rgb(0 0 0 / 0.18) 0%,
      transparent 80%
    );
    pointer-events: none;
  }

  .page-header__inner {
    position: relative;
    z-index: 1;
    max-width: var(--vrm-container-width);
    margin-inline: auto;
    padding-inline: var(--vrm-space-lg);
  }

  .page-header__kicker {
    font-family: var(--vrm-font-body);
    font-size: var(--vrm-font-size-sm);
    font-weight: var(--vrm-font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.85);
    margin-bottom: var(--vrm-space-sm);
  }

  .page-header__title {
    color: var(--vrm-color-text-inverted);
    font-size: clamp(var(--vrm-font-size-2xl), 4.5vw, var(--vrm-font-size-4xl));
    line-height: var(--vrm-line-height-tight);
    margin-bottom: var(--vrm-space-sm);
    text-shadow: 0 2px 8px rgb(0 0 0 / 0.25);
  }

  .page-header__lead {
    font-size: var(--vrm-font-size-lg);
    color: rgb(255 255 255 / 0.92);
    max-width: 60ch;
    margin: 0 auto;
  }

  @media (max-width: 600px) {
    .page-header {
      padding-block: var(--vrm-space-xl);
    }
    .page-header__inner {
      padding-inline: var(--vrm-space-md);
    }
  }
</style>
