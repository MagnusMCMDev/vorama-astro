---
/**
 * PageHeader — hero compacto sin imagen, fondo degradado.
 * Para páginas internas donde el "hero" del WP era solo texto sobre gradient.
 */
interface Props {
  kicker?: string | undefined;
  title: string;
  lead?: string | undefined;
}

const { kicker, title, lead } = Astro.props;
---

<header class="page-header">
  <div class="page-header__inner">
    {kicker && <p class="page-header__kicker">{kicker}</p>}
    <h1 class="page-header__title">{title}</h1>
    {lead && <p class="page-header__lead">{lead}</p>}
  </div>
</header>

<style>
  .page-header {
    /* Doble capa: radial cálido emergiendo desde abajo-derecha
       (efecto "sol naciente") + degradado base diagonal. */
    background:
      radial-gradient(
        ellipse 80% 100% at 100% 110%,
        rgb(140 220 200 / 0.85) 0%,
        rgb(83 162 146 / 0.4) 35%,
        transparent 70%
      ),
      linear-gradient(
        135deg,
        #0a3027 0%,
        #14463c 35%,
        var(--vrm-color-primary) 70%,
        #2d7a6b 100%
      );
    color: var(--vrm-color-text-inverted);
    padding-block: var(--vrm-space-2xl);
    text-align: center;
    position: relative;
  }

  /* Capa sutil que asegura legibilidad del título sobre el gradient
     cálido del bottom-right (donde el verde se aclara más). */
  .page-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 60% 70% at 50% 50%,
      rgb(0 0 0 / 0.18) 0%,
      transparent 80%
    );
    pointer-events: none;
  }

  .page-header__inner {
    position: relative;
    z-index: 1;
    max-width: var(--vrm-container-width);
    margin-inline: auto;
    padding-inline: var(--vrm-space-lg);
  }

  .page-header__kicker {
    font-family: var(--vrm-font-body);
    font-size: var(--vrm-font-size-sm);
    font-weight: var(--vrm-font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.85);
    margin-bottom: var(--vrm-space-sm);
  }

  .page-header__title {
    color: var(--vrm-color-text-inverted);
    font-size: clamp(var(--vrm-font-size-2xl), 4.5vw, var(--vrm-font-size-4xl));
    line-height: var(--vrm-line-height-tight);
    margin-bottom: var(--vrm-space-sm);
    text-shadow: 0 2px 8px rgb(0 0 0 / 0.25);
  }

  .page-header__lead {
    font-size: var(--vrm-font-size-lg);
    color: rgb(255 255 255 / 0.92);
    max-width: 60ch;
    margin: 0 auto;
  }

  @media (max-width: 600px) {
    .page-header {
      padding-block: var(--vrm-space-xl);
    }
    .page-header__inner {
      padding-inline: var(--vrm-space-md);
    }
  }
</style>
