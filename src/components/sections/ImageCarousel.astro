---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface CarouselImage {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  images: CarouselImage[];
  /** ID único si hay más de un carrusel en la misma página */
  id?: string;
  /** ms entre transiciones automáticas. Por defecto 5000. 0 desactiva. */
  autoplayMs?: number;
}

const { images, id = 'carousel', autoplayMs = 5000 } = Astro.props;
---

<div
  class="carousel"
  role="region"
  aria-label="Galería de imágenes"
  aria-roledescription="carrusel"
  id={id}
  data-autoplay={autoplayMs}
>
  <div class="carousel__track" id={`${id}-track`}>
    {images.map((img, i) => (
      <figure
        class="carousel__slide"
        id={`${id}-slide-${i + 1}`}
        aria-label={`Imagen ${i + 1} de ${images.length}`}
        aria-roledescription="slide"
      >
        <Image
          src={img.src}
          alt={img.alt}
          class="carousel__img"
          loading={i === 0 ? 'eager' : 'lazy'}
          widths={[480, 800, 1200]}
          sizes="(max-width: 600px) 100vw, (max-width: 1024px) 80vw, 60vw"
        />
      </figure>
    ))}
  </div>

  {images.length > 1 && (
    <>
      <button type="button" class="carousel__arrow carousel__arrow--prev" data-direction="prev" aria-label="Imagen anterior">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </button>
      <button type="button" class="carousel__arrow carousel__arrow--next" data-direction="next" aria-label="Siguiente imagen">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </button>
    </>
  )}
</div>

<style>
  /* ── Contenedor ──────────────────────────────────────────── */
  .carousel {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--vrm-radius-lg);
  }

  /* ── Track ───────────────────────────────────────────────── */
  .carousel__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  /* ── Slide ───────────────────────────────────────────────── */
  .carousel__slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    margin: 0;
    max-height: 480px;
    overflow: hidden;
  }

  .carousel__img {
    width: 100%;
    height: 100%;
    max-height: 480px;
    object-fit: cover;
    display: block;
  }

  /* ── Flechas prev/next ───────────────────────────────────── */
  .carousel__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background-color: rgb(255 255 255 / 0.85);
    color: var(--vrm-color-primary);
    border: none;
    border-radius: 50%;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.15);
    cursor: pointer;
    z-index: 2;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    transition:
      background-color var(--vrm-transition-fast),
      transform var(--vrm-transition-fast),
      box-shadow var(--vrm-transition-fast);
  }

  .carousel__arrow:hover,
  .carousel__arrow:focus-visible {
    background-color: var(--vrm-color-primary);
    color: var(--vrm-color-text-inverted);
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.25);
    outline: none;
  }

  .carousel__arrow--prev {
    left: var(--vrm-space-md);
  }

  .carousel__arrow--next {
    right: var(--vrm-space-md);
  }

  .carousel__arrow:active {
    transform: translateY(-50%) scale(0.94);
  }

  @media (max-width: 600px) {
    .carousel__arrow {
      width: 38px;
      height: 38px;
    }
    .carousel__arrow--prev { left: var(--vrm-space-sm); }
    .carousel__arrow--next { right: var(--vrm-space-sm); }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel__track {
      scroll-behavior: auto;
    }
    .carousel__arrow {
      transition: none;
    }
  }
</style>

<script>
  type Carousel = {
    el: HTMLElement;
    track: HTMLElement;
    slides: HTMLElement[];
    autoplayMs: number;
    timer: number | null;
  };

  function setup(el: HTMLElement): Carousel | null {
    const track = el.querySelector<HTMLElement>('.carousel__track');
    if (!track) return null;
    const slides = Array.from(el.querySelectorAll<HTMLElement>('.carousel__slide'));
    if (slides.length < 2) return null;
    const autoplayMs = Number(el.dataset.autoplay ?? '0');
    return { el, track, slides, autoplayMs, timer: null };
  }

  function currentIndex(c: Carousel): number {
    const w = c.track.clientWidth;
    if (w === 0) return 0;
    return Math.round(c.track.scrollLeft / w);
  }

  function goTo(c: Carousel, index: number): void {
    const len = c.slides.length;
    const i = ((index % len) + len) % len; // wrap around
    const w = c.track.clientWidth;
    c.track.scrollTo({ left: i * w, behavior: 'smooth' });
  }

  function next(c: Carousel): void { goTo(c, currentIndex(c) + 1); }
  function prev(c: Carousel): void { goTo(c, currentIndex(c) - 1); }

  function startAutoplay(c: Carousel): void {
    if (c.autoplayMs <= 0) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return;
    stopAutoplay(c);
    c.timer = window.setInterval(() => next(c), c.autoplayMs);
  }

  function stopAutoplay(c: Carousel): void {
    if (c.timer !== null) {
      window.clearInterval(c.timer);
      c.timer = null;
    }
  }

  document.querySelectorAll<HTMLElement>('.carousel').forEach((el) => {
    const c = setup(el);
    if (!c) return;

    el.querySelectorAll<HTMLButtonElement>('.carousel__arrow').forEach((btn) => {
      btn.addEventListener('click', () => {
        stopAutoplay(c);
        if (btn.dataset.direction === 'prev') prev(c);
        else next(c);
        // Reanudar autoplay tras 8s de inactividad
        if (c.autoplayMs > 0) {
          window.setTimeout(() => startAutoplay(c), 8000);
        }
      });
    });

    // Pausar autoplay al pasar el ratón / interactuar
    el.addEventListener('mouseenter', () => stopAutoplay(c));
    el.addEventListener('mouseleave', () => startAutoplay(c));
    el.addEventListener('focusin', () => stopAutoplay(c));
    el.addEventListener('focusout', () => startAutoplay(c));

    // Pausar si la pestaña no es visible (eficiencia + respeto al usuario)
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopAutoplay(c);
      else startAutoplay(c);
    });

    // Iniciar
    startAutoplay(c);
  });
</script>
