---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface CarouselImage {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  images: CarouselImage[];
  showDots?: boolean;
  /** ID único si hay más de un carrusel en la misma página */
  id?: string;
}

const { images, showDots = true, id = 'carousel' } = Astro.props;
---

<div class="carousel" role="region" aria-label="Galería de imágenes" id={id}>
  <div class="carousel__track" id={`${id}-track`}>
    {images.map((img, i) => (
      <figure
        class="carousel__slide"
        id={`${id}-slide-${i + 1}`}
        aria-label={`Imagen ${i + 1} de ${images.length}`}
      >
        <Image
          src={img.src}
          alt={img.alt}
          class="carousel__img"
          loading={i === 0 ? 'eager' : 'lazy'}
          widths={[480, 800, 1200]}
          sizes="(max-width: 600px) 100vw, (max-width: 1024px) 80vw, 60vw"
        />
      </figure>
    ))}
  </div>

  {showDots && (
    <nav class="carousel__dots" aria-label="Ir a imagen">
      <ol role="list">
        {images.map((_, i) => (
          <li>
            <a
              href={`#${id}-slide-${i + 1}`}
              class="carousel__dot"
              aria-label={`Imagen ${i + 1}`}
            />
          </li>
        ))}
      </ol>
    </nav>
  )}
</div>

<style>
  /* ── Contenedor ──────────────────────────────────────────── */

  .carousel {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--vrm-radius-lg);
  }

  /* ── Track ───────────────────────────────────────────────── */

  .carousel__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    /* Ocultar scrollbar pero permitir scroll */
    scrollbar-width: none;
    -ms-overflow-style: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  /* ── Slide ───────────────────────────────────────────────── */

  .carousel__slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    margin: 0;
    max-height: 480px;
    overflow: hidden;
  }

  .carousel__img {
    width: 100%;
    height: 100%;
    max-height: 480px;
    object-fit: cover;
    display: block;
  }

  /* ── Dots ────────────────────────────────────────────────── */

  .carousel__dots {
    position: absolute;
    bottom: var(--vrm-space-md);
    left: 50%;
    transform: translateX(-50%);

    & ol {
      display: flex;
      gap: var(--vrm-space-sm);
      list-style: none;
      margin: 0;
      padding: var(--vrm-space-xs) var(--vrm-space-sm);
      background-color: rgb(0 0 0 / 0.35);
      border-radius: var(--vrm-radius-full);
      backdrop-filter: blur(4px);
    }
  }

  .carousel__dot {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: rgb(255 255 255 / 0.5);
    transition: background-color var(--vrm-transition-fast);

    &:hover,
    &:focus-visible {
      background-color: rgb(255 255 255 / 0.9);
    }
  }

  /* Dot activo — usa :target-within en el slide */
  .carousel__slide:target ~ * .carousel__dot {
    /* Difícil sin JS. Se deja visual estático — mejorable en B8 */
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel__track {
      scroll-behavior: auto;
    }
  }
</style>
