---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface CarouselImage {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  images: CarouselImage[];
  /** ID único si hay más de un carrusel en la misma página */
  id?: string;
  /** ms entre transiciones automáticas. Por defecto 5000. 0 desactiva. */
  autoplayMs?: number;
}

const { images, id = 'carousel', autoplayMs = 5000 } = Astro.props;
---

<div
  class="carousel"
  role="region"
  aria-label="Galería de imágenes"
  aria-roledescription="carrusel"
  id={id}
  data-autoplay={autoplayMs}
>
  <div class="carousel__track" id={`${id}-track`}>
    {images.map((img, i) => (
      <figure
        class="carousel__slide"
        id={`${id}-slide-${i + 1}`}
        aria-label={`Imagen ${i + 1} de ${images.length}`}
        aria-roledescription="slide"
      >
        <Image
          src={img.src}
          alt={img.alt}
          class="carousel__img"
          loading={i === 0 ? 'eager' : 'lazy'}
          widths={[480, 800, 1200]}
          sizes="(max-width: 600px) 100vw, (max-width: 1024px) 80vw, 60vw"
        />
      </figure>
    ))}
  </div>

  {images.length > 1 && (
    <>
      <button type="button" class="carousel__arrow carousel__arrow--prev" data-direction="prev" aria-label="Imagen anterior">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </button>
      <button type="button" class="carousel__arrow carousel__arrow--next" data-direction="next" aria-label="Siguiente imagen">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </button>
      {autoplayMs > 0 && (
        <button type="button" class="carousel__toggle" data-carousel-toggle data-state="playing" aria-label="Pausar el pase automático de imágenes">
          <svg class="carousel__icon carousel__icon--pause" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/>
          </svg>
          <svg class="carousel__icon carousel__icon--play" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </button>
      )}
    </>
  )}
</div>

<style>
  /* ── Contenedor ──────────────────────────────────────────── */
  .carousel {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--vrm-radius-lg);
  }

  /* ── Track ───────────────────────────────────────────────── */
  .carousel__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  /* ── Slide ───────────────────────────────────────────────── */
  .carousel__slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    margin: 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .carousel__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* ── Flechas prev/next ───────────────────────────────────── */
  .carousel__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background-color: rgb(255 255 255 / 0.4);
    color: #fff;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: 50%;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.18);
    cursor: pointer;
    z-index: 2;
    -webkit-backdrop-filter: blur(8px) saturate(1.4);
    backdrop-filter: blur(8px) saturate(1.4);
    transition:
      background-color var(--vrm-transition-fast),
      color var(--vrm-transition-fast),
      transform var(--vrm-transition-fast),
      box-shadow var(--vrm-transition-fast);
  }

  .carousel__arrow:hover,
  .carousel__arrow:focus-visible {
    background-color: rgb(255 255 255 / 0.85);
    color: var(--vrm-color-primary);
    border-color: rgb(255 255 255 / 0.85);
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.25);
    outline: none;
  }

  .carousel__arrow--prev {
    left: var(--vrm-space-md);
  }

  .carousel__arrow--next {
    right: var(--vrm-space-md);
  }

  .carousel__arrow:active {
    transform: translateY(-50%) scale(0.94);
  }

  /* ── Pausa / reanudar (WCAG 2.2.2) ───────────────────────── */
  .carousel__toggle {
    position: absolute;
    right: var(--vrm-space-md);
    bottom: var(--vrm-space-md);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background-color: rgb(255 255 255 / 0.4);
    color: #fff;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: 50%;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.18);
    cursor: pointer;
    z-index: 2;
    -webkit-backdrop-filter: blur(8px) saturate(1.4);
    backdrop-filter: blur(8px) saturate(1.4);

    &:hover,
    &:focus-visible {
      background-color: rgb(255 255 255 / 0.85);
      color: var(--vrm-color-primary);
      outline: none;
    }
  }

  .carousel__toggle[data-state="playing"] .carousel__icon--play,
  .carousel__toggle[data-state="paused"] .carousel__icon--pause {
    display: none;
  }

  @media (max-width: 600px) {
    .carousel__arrow {
      width: 38px;
      height: 38px;
    }
    .carousel__arrow--prev { left: var(--vrm-space-sm); }
    .carousel__arrow--next { right: var(--vrm-space-sm); }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel__track {
      scroll-behavior: auto;
    }
    .carousel__arrow {
      transition: none;
    }
  }
</style>

<script>
  type Carousel = {
    el: HTMLElement;
    track: HTMLElement;
    slides: HTMLElement[];
    autoplayMs: number;
    timer: number | null;
    /** Pausado por el usuario (botón) o por preferir movimiento reducido. */
    paused: boolean;
    toggle: HTMLButtonElement | null;
  };

  function setup(el: HTMLElement): Carousel | null {
    const track = el.querySelector<HTMLElement>('.carousel__track');
    if (!track) return null;
    const slides = Array.from(el.querySelectorAll<HTMLElement>('.carousel__slide'));
    if (slides.length < 2) return null;
    const autoplayMs = Number(el.dataset.autoplay ?? '0');
    const paused = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const toggle = el.querySelector<HTMLButtonElement>('[data-carousel-toggle]');
    return { el, track, slides, autoplayMs, timer: null, paused, toggle };
  }

  function currentIndex(c: Carousel): number {
    const w = c.track.clientWidth;
    if (w === 0) return 0;
    return Math.round(c.track.scrollLeft / w);
  }

  function goTo(c: Carousel, index: number): void {
    const len = c.slides.length;
    const i = ((index % len) + len) % len; // wrap around
    const w = c.track.clientWidth;
    c.track.scrollTo({ left: i * w, behavior: 'smooth' });
  }

  function next(c: Carousel): void { goTo(c, currentIndex(c) + 1); }
  function prev(c: Carousel): void { goTo(c, currentIndex(c) - 1); }

  function startAutoplay(c: Carousel): void {
    if (c.autoplayMs <= 0 || c.paused) return;
    stopAutoplay(c);
    c.timer = window.setInterval(() => next(c), c.autoplayMs);
  }

  function stopAutoplay(c: Carousel): void {
    if (c.timer !== null) {
      window.clearInterval(c.timer);
      c.timer = null;
    }
  }

  document.querySelectorAll<HTMLElement>('.carousel').forEach((el) => {
    const c = setup(el);
    if (!c) return;

    // Las flechas adelantan/retroceden sin pausar el autoplay
    el.querySelectorAll<HTMLButtonElement>('.carousel__arrow').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.dataset.direction === 'prev') prev(c);
        else next(c);
      });
    });

    // Botón de pausa: el usuario detiene o reanuda el pase automático.
    const syncToggle = () => {
      if (!c.toggle) return;
      c.toggle.dataset.state = c.paused ? 'paused' : 'playing';
      c.toggle.setAttribute('aria-label', c.paused
        ? 'Reanudar el pase automático de imágenes'
        : 'Pausar el pase automático de imágenes');
    };
    c.toggle?.addEventListener('click', () => {
      c.paused = !c.paused;
      if (c.paused) stopAutoplay(c);
      else startAutoplay(c);
      syncToggle();
    });
    syncToggle();

    // Mientras el ratón o el foco están dentro, no se mueve (se reanuda al salir si no está pausado).
    el.addEventListener('mouseenter', () => stopAutoplay(c));
    el.addEventListener('mouseleave', () => startAutoplay(c));
    el.addEventListener('focusin', () => stopAutoplay(c));
    el.addEventListener('focusout', (e) => {
      if (!el.contains(e.relatedTarget as Node | null)) startAutoplay(c);
    });

    // Pestaña oculta: parar (ahorro de recursos); al volver, reanudar si no está pausado.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopAutoplay(c);
      else startAutoplay(c);
    });

    startAutoplay(c);
  });
</script>
