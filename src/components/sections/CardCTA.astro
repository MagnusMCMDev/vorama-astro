---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  cta: { label: string; href: string };
  image: ImageMetadata;
  imageAlt: string;
}

const { title, cta, image, imageAlt } = Astro.props;
---

<article class="card-cta">
  <Image
    src={image}
    alt={imageAlt}
    class="card-cta__bg"
    loading="lazy"
    widths={[480, 768]}
    sizes="(max-width: 600px) 100vw, 33vw"
  />
  <div class="card-cta__overlay" aria-hidden="true"></div>
  <div class="card-cta__content">
    <h3 class="card-cta__title">{title}</h3>
    <a href={cta.href} class="card-cta__btn">
      {cta.label}
    </a>
  </div>
</article>

<style>
  .card-cta {
    position: relative;
    overflow: hidden;
    border-radius: var(--vrm-radius-lg);
    min-height: 320px;
    display: flex;
    align-items: flex-end;
  }

  .card-cta__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--vrm-transition-slow);
  }

  .card-cta:hover .card-cta__bg {
    transform: scale(1.04);
  }

  .card-cta__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.72) 0%,
      rgb(0 0 0 / 0.2) 60%,
      transparent 100%
    );
  }

  .card-cta__content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: var(--vrm-space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--vrm-space-md);
    align-items: flex-start;
  }

  .card-cta__title {
    font-size: var(--vrm-font-size-xl);
    color: var(--vrm-color-text-inverted);
    margin-bottom: 0;
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.4);
  }

  .card-cta__btn {
    display: inline-flex;
    align-items: center;
    padding: var(--vrm-space-xs) var(--vrm-space-md);
    border: 2px solid var(--vrm-color-text-inverted);
    color: var(--vrm-color-text-inverted);
    font-size: var(--vrm-font-size-sm);
    font-weight: var(--vrm-font-weight-semibold);
    border-radius: var(--vrm-radius-full);
    text-decoration: none;
    backdrop-filter: blur(4px);
    background-color: rgb(255 255 255 / 0.12);
    transition:
      background-color var(--vrm-transition-fast),
      color var(--vrm-transition-fast);

    &:hover,
    &:focus-visible {
      background-color: var(--vrm-color-text-inverted);
      color: var(--vrm-color-primary);
      text-decoration: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-cta__bg {
      transition: none;
    }
  }
</style>
