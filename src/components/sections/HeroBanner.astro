---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Texto pequeño sobre el h1 — NO usar h6 */
  kicker?: string | undefined;
  /** h1 de la página — solo uno por página */
  title: string;
  /** Párrafo introductorio */
  lead?: string | undefined;
  /** CTA principal */
  cta?: { label: string; href: string } | undefined;
  /** Imagen hero — LCP: siempre eager + fetchpriority high */
  image: ImageMetadata;
  imageAlt: string;
  /** cover: imagen full-bleed con overlay | split: 50/50 */
  variant?: 'cover' | 'split';
}

const {
  kicker,
  title,
  lead,
  cta,
  image,
  imageAlt,
  variant = 'cover',
} = Astro.props;
---

<div class:list={['hero-banner', `hero-banner--${variant}`]}>
  <!-- Imagen -->
  <div class="hero-banner__media">
    <Image
      src={image}
      alt={imageAlt}
      class="hero-banner__img"
      loading="eager"
      fetchpriority="high"
      widths={[480, 768, 1200, 1600]}
      sizes="(max-width: 768px) 100vw, (max-width: 1024px) 60vw, 50vw"
    />
    {variant === 'cover' && <div class="hero-banner__overlay" aria-hidden="true" />}
  </div>

  <!-- Texto -->
  <div class="hero-banner__content">
    {kicker && <p class="hero-banner__kicker">{kicker}</p>}
    <h1 class="hero-banner__title">{title}</h1>
    {lead && <p class="hero-banner__lead">{lead}</p>}
    {cta && (
      <a href={cta.href} class="hero-banner__cta">
        {cta.label}
      </a>
    )}
  </div>
</div>

<style>
  /* ── Base ────────────────────────────────────────────────── */

  .hero-banner {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .hero-banner__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Variante cover ──────────────────────────────────────── */

  .hero-banner--cover {
    min-height: min(600px, 70svh);

    & .hero-banner__media {
      position: absolute;
      inset: 0;
      z-index: 0;
    }

    & .hero-banner__overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgb(0 0 0 / 0.2) 0%,
        rgb(0 0 0 / 0.55) 100%
      );
    }

    & .hero-banner__content {
      position: relative;
      z-index: 1;
      min-height: min(600px, 70svh);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: var(--vrm-space-xl) var(--vrm-space-lg);
      color: var(--vrm-color-text-inverted);
    }

    & .hero-banner__title {
      color: var(--vrm-color-text-inverted);
    }

    & .hero-banner__kicker {
      color: rgb(255 255 255 / 0.85);
    }

    & .hero-banner__lead {
      color: rgb(255 255 255 / 0.9);
    }
  }

  /* ── Variante split ──────────────────────────────────────── */

  .hero-banner--split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: min(520px, 65svh);

    & .hero-banner__media {
      order: 2;
    }

    & .hero-banner__content {
      order: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: var(--vrm-space-xl) var(--vrm-space-xl) var(--vrm-space-xl) var(--vrm-space-lg);
      max-width: 600px;
      margin-inline-start: auto;
    }
  }

  /* ── Tipografía compartida ───────────────────────────────── */

  .hero-banner__kicker {
    font-family: var(--vrm-font-body);
    font-size: var(--vrm-font-size-sm);
    font-weight: var(--vrm-font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--vrm-color-primary-light);
    margin-bottom: var(--vrm-space-sm);
  }

  .hero-banner__title {
    font-size: clamp(var(--vrm-font-size-2xl), 5vw, var(--vrm-font-size-4xl));
    line-height: var(--vrm-line-height-tight);
    margin-bottom: var(--vrm-space-md);
  }

  .hero-banner__lead {
    font-size: var(--vrm-font-size-lg);
    line-height: var(--vrm-line-height-relaxed);
    max-width: 60ch;
    margin-bottom: var(--vrm-space-lg);
  }

  .hero-banner__cta {
    display: inline-flex;
    align-items: center;
    padding: var(--vrm-space-sm) var(--vrm-space-lg);
    background-color: #fff;
    color: var(--vrm-color-primary);
    font-weight: var(--vrm-font-weight-semibold);
    border-radius: var(--vrm-radius-full);
    text-decoration: none;
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.18);
    transition: background-color var(--vrm-transition-fast), color var(--vrm-transition-fast), transform var(--vrm-transition-fast);
    align-self: flex-start;

    &:hover,
    &:focus-visible {
      background-color: var(--vrm-color-primary);
      color: var(--vrm-color-text-inverted);
      transform: translateY(-2px);
      text-decoration: none;
    }
  }

  /* cover centra el CTA */
  .hero-banner--cover .hero-banner__cta {
    align-self: center;
  }

  /* ── Responsive ──────────────────────────────────────────── */

  @media (max-width: 768px) {
    .hero-banner--split {
      grid-template-columns: 1fr;
      min-height: unset;

      & .hero-banner__media {
        order: 1;
        height: 280px;
      }

      & .hero-banner__content {
        order: 2;
        padding: var(--vrm-space-lg) var(--vrm-space-md);
        max-width: none;
        margin-inline-start: 0;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-banner__cta {
      transition: none;
    }
  }
</style>
