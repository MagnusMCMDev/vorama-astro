---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  duration: string;
  price: string;
  /** Si se proporciona, se usa como aria-label del botón. */
  ariaLabel?: string;
}

const { image, imageAlt, duration, price, ariaLabel } = Astro.props;
---

<button
  type="button"
  class="reserva-card"
  data-dialog="dialog-calendly"
  aria-label={ariaLabel ?? `Reservar sesión de ${duration}`}
>
  <span class="reserva-card__circle">
    <Image
      src={image}
      alt={imageAlt}
      class="reserva-card__img"
      widths={[300, 480]}
      sizes="(max-width: 600px) 70vw, 320px"
    />
  </span>
  <span class="reserva-card__title">Sesión de {duration}</span>
  <span class="reserva-card__price">{price}</span>
</button>

<style>
  .reserva-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--vrm-space-md);
    padding: var(--vrm-space-lg) var(--vrm-space-md);
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: var(--vrm-font-body);
    color: var(--vrm-color-text);
    transition: transform var(--vrm-transition-base);

    &:hover,
    &:focus-visible {
      transform: translateY(-4px);
      outline: none;
    }

    &:focus-visible .reserva-card__circle {
      box-shadow: 0 0 0 4px var(--vrm-color-primary-light), var(--vrm-shadow-md);
    }
  }

  .reserva-card__circle {
    display: block;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: var(--vrm-shadow-md);
    border: 6px solid var(--vrm-color-bg);
    transition: box-shadow var(--vrm-transition-base);

    @media (max-width: 600px) {
      width: 200px;
      height: 200px;
    }
  }

  .reserva-card:hover .reserva-card__circle {
    box-shadow: 0 12px 32px rgb(32 91 79 / 0.25);
  }

  .reserva-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    /* Aclarado suave para visibilidad amable */
    filter: brightness(1.06) saturate(0.95);
    transition: transform var(--vrm-transition-slow);
  }

  .reserva-card:hover .reserva-card__img {
    transform: scale(1.06);
  }

  .reserva-card__title {
    font-size: var(--vrm-font-size-md);
    font-weight: var(--vrm-font-weight-semibold);
    color: var(--vrm-color-primary);
  }

  .reserva-card__price {
    font-family: var(--vrm-font-display);
    font-size: var(--vrm-font-size-2xl);
    font-weight: var(--vrm-font-weight-semibold);
    color: var(--vrm-color-primary);
    line-height: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .reserva-card,
    .reserva-card__img,
    .reserva-card__circle {
      transition: none;
    }
  }
</style>
