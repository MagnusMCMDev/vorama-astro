---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ServiceId } from '~/lib/booking/types.ts';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  duration: string;
  price: string;
  /** ID del servicio concreto (ej. "californiano-90"). Abre el widget en modo directo. */
  serviceId: ServiceId;
  /** Duración en minutos, debe coincidir con el serviceId. */
  durationMin: number;
  /** Si se proporciona, se usa como aria-label del botón. */
  ariaLabel?: string;
}

const { image, imageAlt, duration, price, serviceId, durationMin, ariaLabel } = Astro.props;
---

<button
  type="button"
  class="reserva-card"
  data-dialog="booking"
  data-service-id={serviceId}
  data-duration-min={durationMin}
  aria-label={ariaLabel ?? `Reservar sesión de ${duration}`}
>
  <span class="reserva-card__circle">
    <Image
      src={image}
      alt={imageAlt}
      class="reserva-card__img"
      widths={[300, 480]}
      sizes="(max-width: 600px) 70vw, 320px"
    />
  </span>
  <span class="reserva-card__title">Sesión de {duration}</span>
  <span class="reserva-card__price">{price}</span>
</button>

<style>
  .reserva-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--vrm-space-md);
    padding: var(--vrm-space-lg) var(--vrm-space-md);
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: var(--vrm-font-body);
    color: var(--vrm-color-text);
    transition: transform var(--vrm-transition-base);

    &:hover,
    &:focus-visible {
      transform: translateY(-4px);
      outline: none;
    }

    &:focus-visible .reserva-card__circle {
      box-shadow: 0 0 0 4px var(--vrm-color-primary-light), var(--vrm-shadow-md);
    }
  }

  .reserva-card__circle {
    display: block;
    /* Tamaño responsive: mínimo 280px en mobile, fluido por viewport
       (36vw) y máximo 380px en pantallas grandes. */
    width: clamp(280px, 36vw, 380px);
    height: clamp(280px, 36vw, 380px);
    border-radius: 50%;
    overflow: hidden;
    box-shadow: var(--vrm-shadow-md);
    border: 6px solid var(--vrm-color-bg);
    transition: box-shadow var(--vrm-transition-base);
  }

  .reserva-card:hover .reserva-card__circle {
    box-shadow: 0 12px 32px rgb(32 91 79 / 0.25);
  }

  .reserva-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    /* Aclarado suave para visibilidad amable */
    filter: brightness(1.06) saturate(0.95);
    /* Zoom largo y suave (igual que CardCTA / offer-card). */
    transition: transform 1600ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .reserva-card:hover .reserva-card__img,
  .reserva-card:focus-visible .reserva-card__img,
  .reserva-card:active .reserva-card__img {
    transform: scale(1.14);
  }

  .reserva-card__title {
    font-size: var(--vrm-font-size-md);
    font-weight: var(--vrm-font-weight-semibold);
    color: var(--vrm-color-primary);
  }

  .reserva-card__price {
    font-family: var(--vrm-font-display);
    font-size: var(--vrm-font-size-2xl);
    font-weight: var(--vrm-font-weight-semibold);
    color: var(--vrm-color-primary);
    line-height: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .reserva-card,
    .reserva-card__img,
    .reserva-card__circle {
      transition: none;
    }
  }
</style>
