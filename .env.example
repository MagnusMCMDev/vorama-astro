# ──────────────────────────────────────────────────────────────────────────────
# Variables de entorno — Sistema de Reservas Voramà
# ──────────────────────────────────────────────────────────────────────────────
# Copia este archivo a .env y rellena los valores.
# En producción (GitHub Actions) configúralas como repository secrets.
# IMPORTANTE: Todas tienen prefijo PUBLIC_ → quedan visibles en el bundle JS.
# La seguridad se garantiza por restricciones del proveedor, no por ocultación:
#   - Google API key: restringida por HTTP referrer al dominio del sitio.
#   - Web3Forms: protegida por honeypot nativo del servicio.
# ──────────────────────────────────────────────────────────────────────────────

# ── Google Calendar API ───────────────────────────────────────────────────────
# Clave de API creada en Google Cloud Console, restringida a:
#   - HTTP referrer: https://magnusmcmdev.github.io/* (y el dominio final)
#   - API: solo Google Calendar API
PUBLIC_GCAL_API_KEY=

# ID del calendario que se consulta para ver disponibilidad libre/ocupado.
# El calendario DEBE estar compartido en modo "Ver solo libre/ocupado".
PUBLIC_GCAL_CALENDAR_ID=

# ── Web3Forms ─────────────────────────────────────────────────────────────────
# Access key obtenida en https://web3forms.com con el email destino de Miguel.
PUBLIC_WEB3FORMS_KEY=

# Access key del formulario de CONTACTO (página /contacto/).
PUBLIC_WEB3FORMS_KEY_CONTACTO=

# Access key del formulario de REGALA MASAJE (página /regala-masaje/).
PUBLIC_WEB3FORMS_KEY_REGALA=

# ── Parámetros de negocio (opcionales — se usan los defaults si no se definen) ─
# Minutos de buffer antes/después de cada reserva (default: 20)
PUBLIC_BOOKING_BUFFER_MIN=20

# Horas de antelación mínima para reservar (default: 24)
PUBLIC_BOOKING_MIN_ADVANCE_HOURS=24

# Máximo días vista en el calendario (default: 60)
PUBLIC_BOOKING_MAX_DAYS_AHEAD=60

# Paso entre slots candidatos en minutos (default: 15)
PUBLIC_BOOKING_SLOT_STEP_MIN=15

# Zona horaria para mostrar fechas/horas (default: Europe/Madrid)
PUBLIC_BOOKING_TIMEZONE=Europe/Madrid

# Teléfono WhatsApp para el botón de fallback en errores (default: el del negocio)
PUBLIC_BOOKING_WHATSAPP=+34623941891
